# Agent Travel — Backend Environment Configuration
# RAZORPAY TEST MODE CREDENTIALS ONLY
# Obtain these from: https://dashboard.razorpay.com/app/keys (Test Mode)

PORT=5001
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Optional AWS DynamoDB Configuration (If deploying to AWS DynamoDB)
# Leave blank to use durable local persistent store
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=agent_travel_bookings
DYNAMODB_TABLE_USERS=AgentTravelUsers

# Google OAuth 2.0 Configuration (Google Identity Services)
# 1. Create a Web Application OAuth Client ID in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
# 2. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:5001
# 3. Add Authorized redirect URIs:
#    - http://localhost:5173
#    - http://localhost:5173/auth/google/callback
#    - http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com